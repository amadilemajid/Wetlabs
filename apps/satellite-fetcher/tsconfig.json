{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib":    ["ES2022"],
    "strict": true,
    "noImplicitReturns": true,
    "outDir": "dist",
    "baseUrl": ".",
    "declaration": true,
    "sourceMap":   true,
    "esModuleInterop":   true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
