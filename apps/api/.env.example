# -- Server ----------------------------------------------------
NODE_ENV=development
PORT=3000

# -- Database --------------------------------------------------
DATABASE_URL=postgresql://wetlabs:wetlabs_secret@localhost:5432/wetlabs_db

# -- Redis -----------------------------------------------------
REDIS_URL=redis://localhost:6379

# -- RabbitMQ --------------------------------------------------
RABBITMQ_URL=amqp://wetlabs:wetlabs_secret@localhost:5672

# -- Auth ------------------------------------------------------
# Generate with: node -e "const {generateKeyPairSync}=require('crypto'); const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048}); console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString('base64'))"
JWT_PRIVATE_KEY_BASE64=REPLACE_ME
JWT_PUBLIC_KEY_BASE64=REPLACE_ME
JWT_EXPIRES_IN=3600

# -- Security --------------------------------------------------
MSISDN_PEPPER=REPLACE_WITH_32_BYTE_RANDOM_HEX
AT_USSD_HMAC_SECRET=REPLACE_ME
INTERNAL_API_KEY=REPLACE_ME

# -- External APIs ---------------------------------------------
AT_API_KEY=REPLACE_ME
AT_USERNAME=sandbox
SENDGRID_API_KEY=REPLACE_ME
SENTINEL_HUB_CLIENT_ID=REPLACE_ME
SENTINEL_HUB_CLIENT_SECRET=REPLACE_ME

# -- Object Storage --------------------------------------------
S3_BUCKET=wetlabs-photos
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
